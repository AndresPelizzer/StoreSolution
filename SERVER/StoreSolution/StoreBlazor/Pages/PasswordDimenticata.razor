@page "/password-dimenticata"
@using StoreBlazor.Services

<div class="login-center">
    <div class="login-card">
        <div class="brand-logo"><i class="bi bi-key-fill"></i></div>
        <h2 class="form-title">Password dimenticata</h2>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" @bind="richiestareset.Email" />
        </div>

        <button class="btn btn-primary w-100 mt-2" @onclick="Invia">Invia link</button>
        <a href="/" class="d-block text-center mt-3 text-muted small">← Torna al login</a>

        @if (messaggio != null)
        {
            <div class="alert-msg alert-success mt-3">
                <i class="bi bi-check-circle"></i> @messaggio
            </div>
        }
    </div>
</div>

@code {
    RichiestaResetPassword richiestareset = new();
    string? messaggio;

    [Inject]
    public AuthResetService? AuthResetService { get; set; }

    async Task Invia()
    {
        await AuthResetService!.AddRichiesta(richiestareset);
        
        messaggio = "Se l'email è registrata, riceverai un link a breve.";
    }
}

