@code {
    RadzenScheduler<Richiesta>? scheduler;

    [Inject]
    public IRichiesteService? RichiesteService { get; set; }

    int richiesteaperte = 0;

    bool notificaselezionata = false;

    [Inject]
    public IDipendentiService? DipendentiService { get; set; }

    public List<Richiesta>? richieste = new();

    [Parameter]
    public int Id { get; set; }

    [Inject]
    public NotificheService? NotificheService{ get; set; }

    Area? area = new();

    [Inject]
    public IRichiesteFerieService ? RichiesteFerieService { get; set; }

    public List<Notifica> notifiche = new();

    [Inject]
    public IAreeService? AreeService { get; set; }

    [Inject]
    public NavigationManager? Navigation { get; set; }
    public void VisualizzaRichieste(int Id)
    {
        Navigation!.NavigateTo($"area/{Id}/richieste");
    }
    public void VisualizzaDipendenti(int Id)
    {
        Navigation!.NavigateTo($"area/{Id}/dipendenti");
    }




    protected override async Task OnInitializedAsync()
    {

        area = await AreeService!.GetArea(Id);
        richieste = await RichiesteService!.GetRichieste();

        richieste = richieste!.Where(r => r.CodiceArea == Id).ToList();

        richiesteaperte = richieste.Count(r => r.Stato?.Trim() == "Aperta");
        var dipendenti = await DipendentiService!.GetDipendenti();
        var capoArea = dipendenti!.FirstOrDefault(d => d.CodiceAreaAppl == Id && d.CapoArea == true);


        notifiche = await NotificheService!.GetNotificheCapoArea(capoArea!.Codice);

    }
    void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<Richiesta> args)
    {

        var stato = (args.Data!.Stato ?? "")
            .Trim()
            .Replace("\r", "")
            .Replace("\n", "");

        if (stato.Equals("Aperta", StringComparison.OrdinalIgnoreCase))
        {
            args.Attributes["style"] = "background: #198754; color: white;";
        }
        else if (stato.Equals("In lavorazione", StringComparison.OrdinalIgnoreCase))
        {
            args.Attributes["style"] = "background: #ffc107; color: black;";
        }
        else if (stato.Equals("Conclusa", StringComparison.OrdinalIgnoreCase))
        {

            args.Attributes["style"] = "background: #dc3545; color: white;";
        }
    }
    void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<Richiesta> args)
    {
        Navigation!.NavigateTo($"/richiesta/{args.Data!.Codice}");
    }


    void seleziona()
    {
        notificaselezionata = !notificaselezionata;
    }


    public async Task accetta(Notifica notifica)
    {
       
        notifiche.Remove(notifica);
        StateHasChanged();

       
        var tutteLeFerie = await RichiesteFerieService!.GetFerie();
        var feriaInAttesa = tutteLeFerie
            .Where(f => f.Stato == "In Attesa")
            .OrderByDescending(f => f.DataInizio)
            .FirstOrDefault();

        if (feriaInAttesa != null)
        {
            
            await RichiesteFerieService!.AggiornaStato(feriaInAttesa.Codice, "Accettata");

           
            await NotificheService!.AddNotifica(new Notifica
            {
                CodiceDipendente = feriaInAttesa.CodiceDipendente, 
                Messaggio = $"La tua richiesta di ferie dal {feriaInAttesa.DataInizio:dd/MM/yyyy} è stata ACCETTATA ✅",
                DataCreazione = DateTime.Now,
                Letta = false
            });
        }

        
        await NotificheService!.UpdateNotifica(notifica.Codice);
    }

    async Task Rifiuta(Notifica n)
    {
        notifiche.Remove(n);
        StateHasChanged();

        var tutteLeFerie = await RichiesteFerieService!.GetFerie();
        var feriaInAttesa = tutteLeFerie
            .Where(f => f.Stato == "In Attesa")
            .OrderByDescending(f => f.DataInizio)
            .FirstOrDefault();

        if (feriaInAttesa != null)
        {
            
            await RichiesteFerieService!.AggiornaStato(feriaInAttesa.Codice, "Rifiutata");

           
            await NotificheService!.AddNotifica(new Notifica
            {
                CodiceDipendente = feriaInAttesa.CodiceDipendente,
                Messaggio = $"La tua richiesta di ferie dal {feriaInAttesa.DataInizio:dd/MM/yyyy} è stata RIFIUTATA ❌",
                DataCreazione = DateTime.Now,
                Letta = false
            });
        }

        await NotificheService!.UpdateNotifica(n.Codice);
    }

}



        