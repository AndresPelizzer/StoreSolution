@page "/capoarea/{id:int}/home"
@using StoreShared.Interfaces
@using StoreShared.Models
@using Radzen
@using Radzen.Blazor


<div class="container mt-5">
  <div class="card">
        <div class="card-header">
            <h4 class="text-center text-primary">Area @area!.Descrizione</h4>
        </div>
        <div class="card-body">
            <h4>@area!.Note</h4>
        </div>
        <div class="card-footer d-flex justify-content-around align-items-center">
            <button type="button" class="btn btn-outline-primary" @onclick="()=>VisualizzaRichieste(area.Codice)">Visualizza Richieste</button>
            <button type="button" class="btn btn-outline-primary"@onclick="()=>VisualizzaDipendenti(area.Codice)">Visualizza Dipendenti</button>
            <div class="mb-4 align-items-center justify-content-center">
                <h4 class="text-uppercase text-success">Richieste aperte</h4>
            
                    <h4 class="text-uppercase text-center">
                        @richiesteaperte
                    </h4>
               
            </div>
            
       </div>
    </div>

        <h4>Calendario</h4>
        <RadzenScheduler @ref=scheduler
                 style="height: 768px;"
                 TItem="Richiesta"
                 Data="@richieste"
                 StartProperty="DataRichiesta"
                 EndProperty="DataRichiesta"
                 TextProperty="Titolo"
                 SelectedView="SchedulerView.Month"
                 AppointmentRender="OnAppointmentRender"
                 AppointmentSelect="OnAppointmentSelect">
    <ChildContent>
        <RadzenMonthView />
    </ChildContent>
    <Template Context="data">
        @data.Titolo
    </Template>
 </RadzenScheduler>


   
</div>

