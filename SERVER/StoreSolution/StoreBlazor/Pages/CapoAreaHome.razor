@page "/capoarea/{id:int}/home"
@using Radzen
@using Radzen.Blazor
@using StoreBlazor.Services
@using StoreShared.Interfaces
@using StoreShared.Models


<div class="container my-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Area @area!.Descrizione</h4>
            <button type="button" class="btn btn-light position-relative" @onclick="seleziona">
                Notifiche
                @if (notifiche.Any())
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @notifiche.Count()
                    </span>
                }
            </button>
        </div>

        <div class="card-body">
            <p class="text-muted">@area!.Note</p>
            <div class="d-flex gap-3">
                <button class="btn btn-outline-primary" @onclick="() => VisualizzaRichieste(area.Codice)">Richieste</button>
                <button class="btn btn-outline-primary" @onclick="() => VisualizzaDipendenti(area.Codice)">Dipendenti</button>
                <div class="ms-auto me-3 align-self-center">
                    <strong>Richieste Aperte:</strong>
                    <span class="badge bg-success fs-6">@richiesteaperte</span>
                </div>
            </div>
        </div>
    </div>

    @if (notificaselezionata && notifiche.Any())
    {
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Notifiche da Gestire</h5>
            </div>
            <div class="card-body">
                @if (!notifiche.Any())
                {
                    <p class="text-muted mb-0">Nessuna nuova notifica presente.</p>
                }
                @foreach (var n in notifiche)
                {
                    <div class="border-bottom pb-2 mb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@n.Dipendente?.Nome @n.Dipendente?.Cognome</strong>
                            <div class="small text-muted">@n.DataCreazione.ToString("dd/MM/yyyy HH:mm")</div>
                            <div>@n.Messaggio</div>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-success" @onclick="() => accetta(n)">Accetta</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Rifiuta(n)">Rifiuta</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Calendario Richieste</h5>
        </div>
        <div class="card-body p-2">
            <RadzenScheduler @ref=scheduler style="height: 768px;" TItem="Richiesta" Data="@richieste" StartProperty="DataRichiesta" 
            EndProperty="DataRichiesta" 
            TextProperty="Titolo" SelectedView="SchedulerView.Month" AppointmentRender="OnAppointmentRender" 
            AppointmentSelect="OnAppointmentSelect">
           <ChildContent> <RadzenMonthView /> </ChildContent> <Template Context="data"> @data.Titolo </Template> </RadzenScheduler>
        </div>
    </div>
</div>

