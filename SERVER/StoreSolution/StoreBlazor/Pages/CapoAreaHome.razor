@code {
    RadzenScheduler<Richiesta>? scheduler;

    [Inject]
    public IRichiesteService? RichiesteService { get; set; }

    int richiesteaperte = 0;

    [Inject]
    public IDipendentiService? DipendentiService { get; set; }

    public List<Richiesta>? richieste = new();

    [Parameter]
    public int Id { get; set; }

    Area? area = new();

    [Inject]
    public IAreeService? AreeService { get; set; }

    [Inject]
    public NavigationManager? Navigation { get; set; }
    public void VisualizzaRichieste(int Id)
    {
        Navigation!.NavigateTo($"area/{Id}/richieste");
    }
    public void VisualizzaDipendenti(int Id)
    {
        Navigation!.NavigateTo($"area/{Id}/dipendenti");
    }


    protected override async Task OnInitializedAsync()
    {

        area = await AreeService!.GetArea(Id);
        richieste = await RichiesteService!.GetRichieste();

        richieste = richieste!.Where(r => r.CodiceArea == Id).ToList();

        richiesteaperte = richieste.Count(r => r.Stato?.Trim() == "Aperta");
    }
    void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<Richiesta> args)
    {
        
        var stato = (args.Data!.Stato ?? "")
            .Trim()
            .Replace("\r", "")
            .Replace("\n", "");

        if (stato.Equals("Aperta", StringComparison.OrdinalIgnoreCase))
        {
            args.Attributes["style"] = "background: #198754; color: white;";
        }
        else if (stato.Equals("In lavorazione", StringComparison.OrdinalIgnoreCase))
        {
            args.Attributes["style"] = "background: #ffc107; color: black;";
        }
        else if (stato.Equals("Conclusa", StringComparison.OrdinalIgnoreCase))
        {
          
            args.Attributes["style"] = "background: #dc3545; color: white;";
        }
    }
    void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<Richiesta> args)
    {
        Navigation!.NavigateTo($"/richiesta/{args.Data!.Codice}");
    }






}



        