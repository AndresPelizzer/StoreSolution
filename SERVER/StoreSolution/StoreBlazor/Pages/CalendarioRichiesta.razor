@page "/calendario/richiesta/{id:int}"
@using StoreShared.Interfaces
@using Microsoft.AspNetCore.Components.Forms

@if (richiesta == null)
{
    <p>Caricamento...</p>
}
else
{
    <div class="container mt-5">

        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clipboard2-text me-2"></i>@richiesta.Titolo</h5>
                <button class="btn btn-light btn-sm" @onclick="seleziona">
                    <i class="bi bi-info-circle me-1"></i>Dettaglio
                </button>
            </div>

               
            
            <div class="card-body">
                @if (selezionato)
                {
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-between ">
                            <h4 class="text-muted text-uppercase fw-semibold">Dettaglio</h4>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="form-label text-uppercase text-muted">Data</div>
                                <div class="form-control">@richiesta.DataRichiesta</div>
                            </div>

                            <div class="mb-3">
                                <div class="form-label text-uppercase text-muted">Descrizione</div>
                                <div class="form-control">@richiesta.Descrizione</div>
                            </div>

                            
                            <div class="mb-3">
                                <div class="form-labeltext-uppercase text-muted">Stato</div>
                                <span class="badge mb-2 @(richiesta.Stato == "Conclusa" ? "bg-success" : richiesta.Stato == "In lavorazione" ? "bg-warning text-dark" : "bg-secondary")">@richiesta.Stato</span>

                            </div>

                          
                            <div class="mb-3">
                                <div class="form-label text-uppercase text-muted">Cliente</div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class=" table table-striped table-hover table-borderless">
                                            <thead>
                                                <tr>
                                                    <th class="text-center ms-3">Nome</th>
                                                    <th class="text-center  ms-3">Cognome</th>
                                                    <th class="text-center  ms-3">Email</th>
                                                    <th class="text-center  ms-3">Settore</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="text-uppercase text-muted text-center ms-3">@richiesta.Cliente!.Nome</td>
                                                    <td class="text-uppercase text-muted text-center ms-3">@richiesta.Cliente!.Cognome</td>
                                                    <td class="text-uppercase text-muted text-center ms-3">@richiesta.Cliente!.Email</td>
                                                    <td class="text-uppercase text-muted text-center ms-3">@richiesta.Cliente!.Settore</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            


                        </div>
                    </div>
                }

                <div class="mb-3">
                    <div class="form-label text-uppercase text-muted">Titolo</div>
                    <div class="form-control">@richiesta!.Titolo</div>
                </div>

                <div class="mb-3">
                    <div class="form-label text-uppercase text-muted">Descrizione</div>
                    <div class="form-control">@richiesta.Descrizione</div>
                </div>

                <div class="mb-3">
                    <div class="form-label text-uppercase text-muted">Nome Cliente</div>
                    <div class="form-control">@richiesta.Cliente!.Nome</div>
                </div>

             

                <div class="mb-3">
                    <div class="form-label text-uppercase text-muted">Stato</div> 
                   
                    <select name="stato" class="form-select" @bind="richiesta.Stato">
                        <option value="Aperta">Aperta</option>
                        <option value="In lavorazione">In Lavorazione</option>
                        <option value="Conclusa">Conclusa</option>
                        
                    </select>

                </div>
                

                             @if (richiesta.Stato == "Conclusa")
                          {
                           <div class="mb-3">
                          <label class="form-label text-uppercase text-muted">Allegato</label>
                          <InputFile OnChange="CaricaFile" class="form-control" />
                          @if (richiesta.Allegato != null)
                            {
                           <a href="https://localhost:7293/allegati/@richiesta.Allegato" target="_blank" class="text-success">
                         <i class="bi bi-paperclip"></i> @richiesta.Allegato
                         </a>
                            }
        
                        @if (fileSelezionato != null)
                       {
                            <small class="text-muted">File selezionato: @fileSelezionato.Name</small>
                            }
                          </div>
                             }
                else if(richiesta.Stato=="In lavorazione")
                {
                    <div class="mb-3">
                        <div class="card p-2">
                            <div class="card-header">
                                <h4 class="text-muted text-uppercase fw-semibold">Riepilogo Attività richiesta</h4>
                            </div>

                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover table-bordered table-striped">
                                        <thead>

                                            <tr>
                                                <th class="text-muted text-uppercase">Data</th>
                                                <th class="text-muted text-uppercase">Tipologia</th>
                                                <th class="text-muted text-uppercase">Note</th>
                                                <th class="text-muted text-uppercase">Tempo</th>
                                                <th><button class="btn btn-outline-primary" type="button" @onclick="aggiungere">+</button></th>
                                                
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var att in attivitaEsistenti)
                                            {
                                                <tr class="table-light">
                                                    <td>@att.Data.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@att.Tipologia</td>
                                                    <td>@att.Note</td>
                                                    <td>@((int)att.TempoTotale.TotalMinutes) min</td>
                                                    <td></td>
                                                </tr>
                                            }
                                            @foreach (var att in listaAttDip)
                                            {
                                                <tr>
                                                    <td><input type="datetime-local" class="form-control" @bind="att.Data" /></td>
                                                    <td>
                                                        <select class="form-select" @bind="att.Tipologia">
                                                            <option value="Telefonata">Telefonata</option>
                                                            <option value="Incontro">Incontro</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control" @bind="att.Note" />
                                                    </td>

                                                    <td><input type="number" class="form-control" @bind="att.MinutiLavorati" placeholder="Minuti" /></td>
                                                </tr>

                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                   
                     
                }
                <div class="mb-3">
                    <button class="btn btn-outline-success" @onclick="()=> SalvaModifiche(richiesta)">Salva Modifiche</button>
                </div>


            </div>
        </div>



    </div>    

    @* @if (aggiungiriga)
    {

        <tr>
            <td><input type="datetime-local" class="form-control" @bind="AttDip.Data" /></td>
            <td>
                <select class="form-select" @bind="AttDip.Tipologia">
                    <option value="Telefonata">Telefonata</option>
                    <option value="Incontro">Incontro</option>
                </select>
            </td>
            <td>
                <input type="text" class="form-control" @bind="AttDip.Note" />
            </td>

            <td><input type="number" class="form-control" @bind="AttDip.TempoTotale" placeholder="Minuti" /></td>
        </tr>

    } *@



}

@code {
    [Parameter]
    public int Id { get; set; }

    public List<AttDipForm> listaAttDip = new();

    public class AttDipForm
    {
        public DateTime Data { get; set; } = DateTime.Now;
        public string? Tipologia { get; set; }
        public string? Note { get; set; }
        public int MinutiLavorati { get; set; }


    }
    
    Richiesta? richiesta = null;
    [Inject]
    IRichiesteService? RichiesteService { get; set; }

    bool selezionato = false;
    [Inject]
    NavigationManager? Navigation { get; set; }

    [Inject]
    IAttDipService? AttDipService { get; set; }

    bool aggiungiriga = false;
    List<AttDip> attivitaEsistenti = new();


    AttDip AttDip = new();

    IBrowserFile? fileSelezionato;

    void CaricaFile(InputFileChangeEventArgs e)
    {
        fileSelezionato = e.File;
    }

    protected override async Task OnInitializedAsync()
    {
        richiesta = await RichiesteService!.GetRichiesta(Id);
        var tutte = await AttDipService!.GetAttsDip();
        attivitaEsistenti = tutte.Where(a => a.CodiceRichiesta == Id).ToList();
        Console.WriteLine($"Totale AttDip dal DB: {tutte?.Count ?? 0}");
        foreach (var a in tutte ?? new())
        {
            Console.WriteLine($"  CodiceRichiesta: {a.CodiceRichiesta}, Id pagina: {Id}");
        }

        attivitaEsistenti = tutte?.Where(a => a.CodiceRichiesta == Id).ToList() ?? new();
        Console.WriteLine($"Attività filtrate: {attivitaEsistenti.Count}");
    }


    public async Task SalvaModifiche(Richiesta richiesta)
    {
        foreach(var form in listaAttDip)
        {
            var att = new AttDip
                {
                    Data = form.Data,
                    Tipologia = form.Tipologia,
                    Note = form.Note,
                    TempoTotale = TimeSpan.FromMinutes(form.MinutiLavorati),

                    CodiceRichiesta = Id,

                };
                await AttDipService!.AddAttDip(att);
        }


        await RichiesteService!.UpdateRichiesta(richiesta, Id);
        if(fileSelezionato!=null && richiesta.Stato == "Conclusa")
        {
            await RichiesteService.UploadAllegato(Id, fileSelezionato);
        }
        Navigation!.NavigateTo($"calendario/{richiesta.Dipendente!.Codice}");
    }

    void seleziona()
    {
        selezionato = !selezionato;
    }


    void OnComplete(UploadCompleteEventArgs args)
    {
        // console.Log($"Upload complete with server response: {args.RawResponse}");
    }

    void OnProgress(UploadProgressArgs args)
    {

        if (args.Progress == 100)
        {
            foreach (var file in args.Files)
            {
                // console.Log($"Uploaded: {file.Name} / {file.Size} bytes");
            }
        }
    }

    void aggiungere()
    {
        listaAttDip.Add(new AttDipForm());
        
    }



}
