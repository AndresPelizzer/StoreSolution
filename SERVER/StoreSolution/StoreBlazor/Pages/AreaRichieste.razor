@page "/area/{id:int}/richieste"
@using StoreShared.Interfaces
@using StoreShared.Models



<h3>Area Richieste</h3>

<div class="container mt-5">
    <div class="card">
        <div class="card-body">
            <div class="card-header justify-content-between">
                <h4 class="text-center">Richieste</h4>
                <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick=" Torna"><i class="bi bi-arrow-left me-1"></i>Torna</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>
                                    Codice
                                </th>
                                <th>Descrizione</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var richiesta in richieste!)
                            {
                                <tr >
                                    <td>@richiesta.Codice</td>
                                    <td>@richiesta.Descrizione</td>
                                    <td>@richiesta.DataRichiesta</td>
                                    <td> <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AssegnaRichieste(richiesta.Codice)">Assegna Richiesta</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @* <div class="card-footer">
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="()=>AssegnaRichieste(Id)">Assegna Richiesta</button>
            </div> *@
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    [Inject]
    public IAreeService? AreeService { get; set; }

    [Inject]
    public IRichiesteService? RichiesteService { get; set; }


    public List<Richiesta>? richieste = new();

    [Inject]
    public NavigationManager? Navigation { get; set; }


    protected override async Task OnInitializedAsync()
    {
        var area = await AreeService!.GetArea(Id);

        richieste = await RichiesteService!.GetRichieste();

        richieste = richieste!.Where(r => r.CodiceArea == Id).ToList();
    }

    public void AssegnaRichieste(int codice)
    {
        Navigation!.NavigateTo($"area/{Id}/richiesta/{codice}");


    }
    public void Torna()
    {
        Navigation?.NavigateTo($"capoarea/{Id}/home");
    }
}
