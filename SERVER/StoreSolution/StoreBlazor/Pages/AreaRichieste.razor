@page "/aree/{id:int}/richieste"
@using StoreShared.Interfaces
@using StoreShared.Models



<h3>AreaRichieste</h3>

<div class="container mt-5">
    <div class="card">
        <div class="card-body">
            <div class="card-header">
                <h4 class="text-center">Richieste</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>
                                    Codice
                                </th>
                                <th>Descrizione</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var richiesta in richieste!)
                            {
                                <tr>
                                    <td>@richiesta.Codice</td>
                                    <td>@richiesta.Descrizione</td>
                                    <td>@richiesta.DataRichiesta</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    [Inject]
    public IAreeService? AreeService { get; set; }

    [Inject]
    public IRichiesteService? RichiesteService { get; set; }


    public List<Richiesta>? richieste = new();


    protected override async Task OnInitializedAsync()
    {
        var area = await AreeService!.GetArea(Id);

        richieste = await RichiesteService!.GetRichieste();

        richieste = richieste!.Where(r => r.CodiceArea == area!.Codice).ToList();
    }
}
