@page "/cliente/{id:int}/home"
@using Radzen.Blazor.Rendering
@using StoreBlazor.Services
@using StoreShared.Interfaces
@using StoreShared.Models
@layout AdminLayout




<div class="container mt-5">
    <div class="card">
        <div class="card-header d-flex justify-content-around">
            <h3 class="text-sm-start small">Home Cliente</h3>
            <input class="form-control mt-2" placeholder="Cerca per titolo o stato..." @bind="filtro" @bind:event="oninput" style="width:300px" />

          
            <div class="position-relative d-inline-block mt-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleNotifiche">
                    <i class="bi bi-bell-fill"></i>
                    @if (notifiche != null && notifiche.Any())
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @notifiche.Count
                        </span>
                    }
                </button>
            </div>


            <button type="button" class="btn btn-outline-info" @onclick="() => VaiNuovaRichiesta(Id)"> + Nuova Richiesta</button>
        </div>

        @if (mostraNotifiche && notifiche != null && notifiche.Any())
        {
            <div class="card border-warning mx-3 mt-2">
                <div class="card-header bg-warning text-dark">Notifiche</div>
                <ul class="list-group list-group-flush">
                    @foreach (var n in notifiche)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @n.Messaggio
                            <button class="btn btn-sm btn-outline-success" @onclick="() => SegnaLetta(n.Codice)">
                                ✓
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th class="text-center text-dark" @onclick='() => Ordina("Titolo")' style="cursor:pointer">Ttitolo<i class="bi @(ColonnaAttiva == "Titolo" ? (ascending ? "bi-sort-up" : "bi-sort-down") : "bi-sort")" > </i></th>
                            <th class="text-center text-dark" @onclick='() => Ordina("Stato")' style="cursor:pointer">Stato<i class="bi @(ColonnaAttiva == "Stato" ? (ascending ? "bi-sort-up" : "bi-sort-down") : "bi-sort")"> </i></th>
                            <th class="text-center text-dark" @onclick='() => Ordina("Descrizione")' style="cursor:pointer">Descrizione<i class="bi @(ColonnaAttiva == "Descrizione" ? (ascending ? "bi-sort-up" : "bi-sort-down") : "bi-sort")"> </i></th>
                            <th class="text-center text-dark" @onclick='() => Ordina("DataRichiesta")' style="cursor:pointer">Data Richiesta<i class="bi @(ColonnaAttiva == "DataRichiesta" ? (ascending ? "bi-sort-up" : "bi-sort-down") : "bi-sort")"> </i></th>
                            <th class="text-center text-dark"></th>
                            <th class="text-center text-dark">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var richiesta in RichiesteFiltrate!)
                        {
                            <tr>
                                <td class="text-center">@richiesta.Titolo</td>
                                @if (richiesta.Stato == "Aperta")
                                {
                                    <td class="text-center" style="color:forestgreen">Aperta</td>
                                }else if (richiesta.Stato == "Lavorazione")
                                {
                                    <td class="text-center" style="color:gold">In Lavorazione</td>
                                }
                                else if(richiesta.Stato=="Conclusa")
                                {
                                    <td class="text-center" style="color:red">Conclusa</td>
                                }
                                <td class="text-center">@richiesta.Descrizione</td>
                                <td class="text-center">@richiesta.DataRichiesta</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-primary" @onclick="() => ToggleAccordion(richiesta.Codice)"><i class="bi @(RichiestaApertaId== richiesta.Codice? "bi-chevron-up" : "bi-chevron-down")"></i></button>
                                    
                                    
                                </td>
                                <td class="text-center"><button type="button" class="btn btn-outline-danger"@onclick="()=>Elimina(richiesta.Codice)">Elimina</button></td>


                            </tr>
                            @if (RichiestaApertaId == richiesta.Codice)
                            {
                                <tr class="table-light">
                                    <td colspan="6">
                                          <div class="p-3">
                                            <dl class="row mb-0">
                                                <dt class="col-sm-3">Titolo</dt>
                                                <dd class="col-sm-9">@richiesta.Titolo</dd>
                                                <dt class="col-sm-3">Stato</dt>
                                                <dd class="col-sm-9">@richiesta.Stato</dd>
                                                <dt class="col-sm-3">Descrizione</dt>
                                                <dd class="col-sm-9">@richiesta.Descrizione</dd>
                                                <dt class="col-sm-3">Data</dt>
                                                <dd class="col-sm-9">@richiesta.DataRichiesta</dd>
                                            </dl>
                                        </div>
                                    </td>
                                </tr>

                            }
                        }



                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    [Inject]
    public IRichiesteService? RichiesteService { get; set; }

    [Inject]
    public IClientiService? ClientiService { get; set; }

    [Inject]
    public NotificheService? NotificheService { get; set; }


    List<Notifica>? notifiche = new();
    bool mostraNotifiche = false;


    Cliente? cliente = new();

    [Inject]
    public NavigationManager? Navigation { get; set; }

    public List<Richiesta>? richieste = new();

    public string filtro = "";



    public IEnumerable<Richiesta> RichiesteFiltrate => richieste!.Where(r => string.IsNullOrEmpty(filtro) || (r.Titolo != null && r.Titolo.Contains(filtro, StringComparison.OrdinalIgnoreCase)) || (r.Stato != null && r.Stato.Contains(filtro, StringComparison.OrdinalIgnoreCase)));


    protected override async Task OnInitializedAsync()
    {
        richieste= await RichiesteService!.GetRichieste();
        cliente = await ClientiService!.GetCliente(Id);

        richieste = richieste!.Where(r => r.CodiceCliente == cliente!.Codice).ToList();

        notifiche = await NotificheService!.GetNotifiche(Id);

    }
    private bool ascending = true;
    private string ColonnaAttiva = "";
    public void Ordina(string colonna)
    {
        if (ColonnaAttiva==colonna)
        {
            ascending = !ascending;
        }else
        {
            ColonnaAttiva=colonna;

            ascending = true;
        }

        richieste = ascending ? richieste!.OrderBy(r => GetValore(r, colonna)).ToList() : richieste!.OrderByDescending(r => GetValore(r, colonna)).ToList();
    }

    private object GetValore(Richiesta r, string colonna) => colonna switch
    {
        "Titolo" => r.Titolo ?? "",
        "Descrizione" => r.Descrizione ?? "",
        "DataRichiesta" => r.DataRichiesta,
        "Stato" => r.Stato ?? "",
        _ => ""

    };

    private int? RichiestaApertaId = null;


    public void ToggleAccordion(int id)
    {
        if (RichiestaApertaId == id)
        {
            RichiestaApertaId = null;
        }
        else
        {
            RichiestaApertaId = id;
        }
    }

    public async Task Elimina(int id)
    {
        await RichiesteService!.DeleteRichiesta(id);
        richieste = richieste!.Where(r => r.Codice != id).ToList();
    }

    public void VaiNuovaRichiesta(int id)
    {
        Navigation!.NavigateTo($"cliente/{id}/nuovarichiesta");
    }

    void ToggleNotifiche()
    {
        mostraNotifiche = !mostraNotifiche;
    }

    async Task SegnaLetta(int id)
    {
        await NotificheService!.UpdateNotifica(id);
        notifiche = notifiche!.Where(n => n.Codice != id).ToList();
    }
}

