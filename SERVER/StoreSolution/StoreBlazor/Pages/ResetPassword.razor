@page "/reset-password"
@using StoreBlazor.Services

<div class="container mt-5">
    <div class="card-body shadow-sm">
        <div class="card-header">
            <h3> Inserisci Nuova Password </h3>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Nuova password</label>
                <input class="form-control" type="password" @bind="conferma.NuovaPassword"/>
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-outline-primary" type="button" @onclick="Salva">Salva</button>
        </div>
    </div>
</div>




@code {
    [Inject]
    public AuthResetService? AuthResetService { get; set; }
    ConfermaResetPassword conferma = new();
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }
    public bool tokenValido { get; private set; } = true;

    [Inject]
    IJSRuntime? JS { get; set; }

    [Inject]
    public NavigationManager? Navigation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Token))
        {
            tokenValido = false;
        }
        else
        {
            conferma.Token = Token;

        }


    }
    public async Task Salva()
    {
        var response = await AuthResetService!.Conferma(conferma);
        if (response)
        {
            await JS!.InvokeVoidAsync("alert", "Password aggiornata! Vai al login.");
            Navigation!.NavigateTo("/");
        }
        else
        {
            await JS!.InvokeVoidAsync("alert", "Errore, Token non valido o scaduto");
        }
    }


}
