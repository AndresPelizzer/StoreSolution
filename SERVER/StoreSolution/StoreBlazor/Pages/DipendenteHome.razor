@page "/dipendente/{id:int}/home"
@using Radzen.Blazor.Rendering
@using StoreBlazor.Services
@using StoreShared.Interfaces
@using StoreShared.Models
@layout AdminLayout

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <a href="calendario/@Id" class="text-decoration-none dashboard-card-link">
                <h3 class="mb-0 fs-5">
                    <i class="bi bi-calendar3 me-2"></i>CALENDARIO
                </h3>
            </a>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary" @onclick="RichiediFerie">Richiedi Ferie</button>
                <button class="btn btn-primary position-relative" @onclick="seleziona">
                    Notifiche
                    @if (notifiche.Any())
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @notifiche.Count()
                        </span>
                    }
                </button>


                <button type="button" class="btn btn-outline-primary" @onclick="RichiediStraordinari">Richiedi Straordinari</button>
            </div>
        </div>

        @if (selezionata)
        {
            <div class="card m-3 border-info">
                <div class="card-header bg-info text-white fw-bold">Notifiche Ricevute</div>
                <div class="card-body">
                    @if (!notifiche.Any())
                    {
                        <p class="text-muted mb-0">Non hai nuove notifiche.</p>
                    }
                    @foreach (var n in notifiche)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div>
                                <small class="text-muted d-block">@n.DataCreazione.ToString("dd/MM/yyyy HH:mm")</small>
                                <strong>@n.Messaggio</strong>
                            </div>
                            <button class="btn btn-sm btn-outline-success ms-3" @onclick="() => SegnaComeLetta(n)">
                                <i class="bi bi-check-lg"></i> OK
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th @onclick='() => Ordina("Titolo")' style="cursor:pointer">
                                Titolo
                                <i class="bi @(colonnaAttiva == "Titolo" ? (ascending ? "bi-sort-up" : "bi-sort-down") : "bi-sort")"></i>
                            </th>
                            <th @onclick='() => Ordina("Stato")' style="cursor:pointer">
                                Stato
                                <i class="bi @(colonnaAttiva == "Stato" ? (ascending ? "bi-sort-up" : "bi-sort-down") : "bi-sort")"></i>
                            </th>
                            <th @onclick='() => Ordina("Data")' style="cursor:pointer">
                                Data
                                <i class="bi @(colonnaAttiva == "Data" ? (ascending ? "bi-sort-up" : "bi-sort-down") : "bi-sort")"></i>
                            </th>
                            <th>Azione</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var richiesta in richieste!)
                        {
                            <tr>
                                <td>@richiesta.Titolo</td>
                                <td>@richiesta.Stato</td>
                                <td>@richiesta.DataRichiesta.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-link text-dark p-0"
                                            @onclick="() => ToggleAccordion(richiesta.Codice)">
                                        <i class="bi @(richiestaApertaId == richiesta.Codice ? "bi-chevron-up" : "bi-chevron-down") fs-5"></i>
                                    </button>
                                </td>
                            </tr>
                            @if (richiestaApertaId == richiesta.Codice)
                            {
                                <tr class="table-light">
                                    <td colspan="4">
                                        <DettaglioDipendente Richiesta="richiesta"></DettaglioDipendente>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [Inject]
    public NavigationManager? Navigation { get; set; }

    [Inject]
    public IRichiesteService? RichiesteService { get; set; }

    [Inject]
    public IDipendentiService? DipendentiService { get; set; }

    [Inject]
    public NotificheService? NotificheServicee { get; set; }

    public List<Notifica> notifiche = new();
    public List<Richiesta>? richieste = new();

    bool selezionata = false;
    private int? richiestaApertaId = null;

    private string colonnaAttiva = "";
    private bool ascending = true;

    protected override async Task OnInitializedAsync()
    {
        richieste = await RichiesteService!.GetRichieste();
        var dipendente = await DipendentiService!.GetDipendente(Id);

        if (dipendente != null)
        {
            richieste = richieste!.Where(r => r.CodiceDipendente == dipendente.Codice).ToList();
            notifiche = await NotificheServicee!.GetNotificheCapoArea(dipendente.Codice);
        }
    }

    public async Task SegnaComeLetta(Notifica notifica)
    {
        notifiche.Remove(notifica);
        await NotificheServicee!.UpdateNotifica(notifica.Codice);
        StateHasChanged();
    }

    public void ToggleAccordion(int codice)
    {
        richiestaApertaId = richiestaApertaId == codice ? null : codice;
    }

    public void Ordina(string colonna)
    {
        if (colonnaAttiva == colonna)
        {
            ascending = !ascending;
        }
        else
        {
            colonnaAttiva = colonna; 
            ascending = true;
        }

        richieste = ascending
            ? richieste!.OrderBy(r => GetValore(r, colonna)).ToList()
            : richieste!.OrderByDescending(r => GetValore(r, colonna)).ToList();
    }

    private object GetValore(Richiesta r, string colonna) => colonna switch
    {
        "Titolo" => r.Titolo ?? "",
        "Stato" => r.Stato ?? "",
        "Descrizione" => r.Descrizione ?? "",
        "Data" => r.DataRichiesta,
        _ => ""
    };

    void RichiediFerie()
    {
        Navigation!.NavigateTo($"richiestaferie/{Id}");
    }

    void seleziona()
    {
        selezionata = !selezionata;
    }

    void RichiediStraordinari()
    {
        Navigation!.NavigateTo($"richiestastraordinarie/{Id}");
    }
}



