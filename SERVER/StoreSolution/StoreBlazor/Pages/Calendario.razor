@page "/calendario/{id:int}"
@using Radzen
@using Radzen.Blazor
@using StoreBlazor.Services
@using StoreShared.Interfaces
@using StoreShared.Models.StoreDb

@inject AuthState AuthState
<h3>Calendario</h3>

@if (AuthState.IsCapoArea == false)
{
    <button class="btn btn-outline-secondary" @onclick='() => Navigation!.NavigateTo($"dipendente/{Id}/home")'>Torna indietro</button>
}


<RadzenScheduler TItem="EventoCalendario"
                 style="height: 768px;"
                 Data="@eventiCalendario"
                 StartProperty="DataInizio"
                 EndProperty="DataFine"
                 TextProperty="Titolo"
                 SelectedView="SchedulerView.Month"
                 AppointmentRender="OnAppointmentRenderEvento">
    <ChildContent>
        <RadzenMonthView />
    </ChildContent>
    <Template Context="ev">
        <span>@ev.Titolo</span>
    </Template>
</RadzenScheduler>
@code {
    RadzenScheduler<Richiesta>? scheduler;

    [Inject]
    public IRichiesteService? RichiesteService { get; set; }

    [Inject]
    public IDipendentiService? DipendentiService { get; set; }

    public List<Richiesta>? richieste = new();

    [Parameter]
    public int Id { get; set; }

    Area? area = new();

    public List<StoreShared.Models.StoreDb.RichiestaFerie> ferieAccettate = new();

    [Inject]
    IRichiesteFerieService? RichiesteFerieService { get; set; }

    [Inject]
    IAreeService? AreeService { get; set; }

    [Inject]
    public NavigationManager? Navigation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var dipendente = await DipendentiService!.GetDipendente(Id);
        richieste = await RichiesteService!.GetRichieste();

        richieste = richieste!.Where(r => r.CodiceDipendente == dipendente!.Codice).ToList();
        area = await AreeService!.GetArea(dipendente!.CodiceAreaAppl ?? 0);

        var tutteLeFerie = await RichiesteFerieService!.GetFerie();
        ferieAccettate = tutteLeFerie
        .Where(f => f.Stato == "Accettata" && f.CodiceDipendente == dipendente!.Codice)
        .ToList();

        eventiCalendario = richieste!.Select(r => new EventoCalendario
        {
            Titolo = r.Titolo ?? "",
            DataInizio = r.DataRichiesta,
            DataFine = r.DataRichiesta,
            Tipo = "Richiesta"
        }).ToList();

        eventiCalendario.AddRange(ferieAccettate.Select(f => new EventoCalendario
        {
            Titolo = $"Ferie - {f.CodiceDipendente}",
            DataInizio = f.DataInizio,
            DataFine = f.DataFine,
            Tipo = "Ferie"
        }));
    }

    void OnAppointmentRenderEvento(SchedulerAppointmentRenderEventArgs<EventoCalendario> args)
    {
        if (args.Data.Tipo == "Ferie")
        {
            args.Attributes["style"] = "background: #0d6efd; color: white;"; // blu per ferie
        }
        else
        {
            var stato = args.Data.Titolo;
            args.Attributes["style"] = "background: #198754; color: white;";
        }
    }

    void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<Richiesta> args)
    {
        Navigation!.NavigateTo($"/richiesta/{args.Data!.Codice}");
    }
    public class EventoCalendario
    {
        public string Titolo { get; set; } = "";
        public DateTime DataInizio { get; set; }
        public DateTime DataFine { get; set; }
        public string Tipo { get; set; } = ""; 
    }

    public List<EventoCalendario> eventiCalendario = new();

}

