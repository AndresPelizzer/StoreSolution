@inherits LayoutComponentBase
@inject AuthState AuthState
@inject NavigationManager Navigation
@using StoreBlazor.Services
@using StoreShared.Interfaces
@inject NotificationService NotificationService

<RadzenNotification />

<div class="admin-shell">
    <header class="admin-topbar">
        <div class="topbar-brand">
            <i class="bi bi-shield-lock-fill"></i>
            <span>Store Blazor</span>
        </div>
        <div class="topbar-actions">
            
            @if (AuthState.Ruolo == "Admin")
            {
               
                <span class="topbar-role">Amministratore</span>
               

            }else if (AuthState.Ruolo == "cliente")
            {
                <span class="topbar-role">Cliente</span>
               
            }else if (AuthState.Ruolo == "dipendente")
            {
                <span class="topbar-role">Dipendente</span>

                
            }
            <span class="text-muted">Benvenuto <strong>@utente!.Username</strong></span>
            <button class="btn-logout" @onclick="Logout">
                <i class="bi bi-box-arrow-right"></i> Esci
            </button>
        </div>
    </header>


    @* @Body *@







     <div class="d-flex" style="height:100vh">
 
        <div class="d-flex flex-column bg-dark text-white p-3" style="min-width:200px">
            <h6 class="text-uppercase text-secondary mb-3 px-2">Menu</h6>



            @if (AuthState.Ruolo == "Admin")
            {


                <a class="btn text-start mb-2 btn-outline-light" href="clienti">
                <i class="bi bi-people-fill me-2"></i>Clienti
            </a>

            <a class="btn text-start mb-2 btn-outline-light" href="dipendenti">
                <i class="bi bi-people-fill me-2"></i>Dipendenti
            </a>


            <a class="btn text-start mb-2 btn-outline-light" href="aree">
                <i class="bi bi-people-fill me-2"></i>Aree
            </a> 



            <a class="btn text-start mb-2 btn-outline-light" href="richieste">
                <i class="bi bi-people-fill me-2"></i>Richieste
            </a>
            }else if (AuthState.Ruolo == "dipendente" && AuthState.IsCapoArea==false) 
            {
                <a class="btn text-start mb-2 btn-outline-light" href="@("calendario/" + Dipendente!.Codice)">
                    <i class="bi bi-people-fill me-2"></i>Calendario
                </a>



                <a class="btn text-start mb-2 btn-outline-light" href="@("dipendente/" + Dipendente!.Codice + "/home")">
                    <i class="bi bi-people-fill me-2"></i>Riepilogo
                </a>
            }else if(AuthState.Ruolo=="dipendente" && AuthState.IsCapoArea == true)
            {
                <a class="btn text-start mb-2 btn-outline-light" href="@("capoarea/" + Dipendente!.Area!.Codice + "/home")">
                    <i class="bi bi-people-fill me-2"></i>Riepilogo
                </a>
                
                <a class="btn text-start mb-2 btn-outline-light" href="@("calendario/capoarea/" + Dipendente!.Area!.Codice )">
                    <i class="bi bi-people-fill me-2"></i>Calendario
                </a>


                
            }else if (AuthState.Ruolo == "cliente")
            {
                <a class="btn text-start mb-2 btn-outline-light" href="@("/cliente/" + Cliente!.Codice + "/home")">
                    <i class="bi bi-people-fill me-2"></i>Home
                </a>
            }



        </div> 

    
        <div class="flex-grow-1 p-4">

            @Body

        </div>
    </div>


 





</div>

@code {

    [Inject]
    public IUtentiService? UtentiService { get; set; }

    [Inject]
    public IDipendentiService? DipendentiService { get; set; }

    public List<Dipendente>? dipendenti = new();

    Utente? utente = new();

    public List<Utente>? utenti = new();

    Dipendente? Dipendente = new();

    Cliente? Cliente = new();

    [Inject]
    public IClientiService? ClientiService { get; set; }

    public List<Cliente>? clienti { get; set; }

    void Logout()
    {
        AuthState.Token = null;
        AuthState.Ruolo = null;
        AuthState.CodiceUtente = null;
        AuthState.IsCapoArea = false;
        AuthState.BenvenutoMostrato = false;
        Navigation.NavigateTo("/", forceLoad: true);
    }

    protected override async Task OnInitializedAsync()
    {
        clienti = await ClientiService!.GetClienti();
        dipendenti = await DipendentiService!.GetDipendenti();

        var ut = await UtentiService!.GetUtente(AuthState.CodiceUtente ?? 0);
        Dipendente = dipendenti!.FirstOrDefault(d => d.Codice == ut!.CodiceDipendente);
      Cliente = clienti!.FirstOrDefault(c => c.Codice == ut!.CodiceCliente);


        if (AuthState.CodiceUtente != null)
        {
            utente = await UtentiService!.GetUtente(AuthState.CodiceUtente.Value);

            if (!AuthState.BenvenutoMostrato)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = $"Benvenuto, {utente?.Username}!",
                    Detail = "Accesso effettuato con successo",
                    Duration = 3000
                });
            }
            AuthState.BenvenutoMostrato = true;

            
            
        }
    }

}







